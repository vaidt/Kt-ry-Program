{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vaidt/Kt-ry-Program/schemas/source-identity-evidence.schema.json",
  "title": "ASIG Execution Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "expected_manifest_sha256",
    "test_plan",
    "test_results",
    "independent_evaluation"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_id": { "type": "string", "minLength": 1 },
    "expected_manifest_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "test_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_test_ids",
        "executed_test_ids",
        "complete",
        "expected_test_source_sha256",
        "observed_test_source_sha256"
      ],
      "properties": {
        "required_test_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "executed_test_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "complete": { "type": "boolean" },
        "expected_test_source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "observed_test_source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "test_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "status"],
        "properties": {
          "test_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PASS", "FAIL", "UNKNOWN", "NOT_APPLICABLE"] }
        }
      }
    },
    "independent_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "delivered_artifact_sha256", "tested_artifact_sha256"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "delivered_artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "tested_artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
